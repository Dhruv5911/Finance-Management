# FinAI Environment Configuration

# Flask Secret Key
SECRET_KEY=finai-super-secret-key-change-me

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:5173

# Gmail SMTP for Email OTP Verification
MAIL_USERNAME=
